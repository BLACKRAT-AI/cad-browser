# CAD Browser - embeds src/resources/* into a generated C++ translation unit.
#
# Run in script mode:
#   cmake -DCAD_ROOT=<resource dir> -DCAD_FILES=<;-list of relative paths>
#         -DCAD_OUT_CC=<path> -DCAD_OUT_H=<path>
#         -P cmake/embed_resources.cmake
#
# Keeping the UI resources inside the binary is what lets cad:// pages load
# with no disk or network access at startup.

if(NOT DEFINED CAD_ROOT OR NOT DEFINED CAD_FILES OR
   NOT DEFINED CAD_OUT_CC OR NOT DEFINED CAD_OUT_H)
  message(FATAL_ERROR "embed_resources.cmake: missing required -D arguments")
endif()

function(cad_mime_for_path path out_var)
  get_filename_component(ext "${path}" EXT)
  string(TOLOWER "${ext}" ext)
  if(ext STREQUAL ".html" OR ext STREQUAL ".htm")
    set(mime "text/html")
  elseif(ext STREQUAL ".css")
    set(mime "text/css")
  elseif(ext STREQUAL ".js")
    set(mime "text/javascript")
  elseif(ext STREQUAL ".json")
    set(mime "application/json")
  elseif(ext STREQUAL ".svg")
    set(mime "image/svg+xml")
  elseif(ext STREQUAL ".png")
    set(mime "image/png")
  elseif(ext STREQUAL ".woff2")
    set(mime "font/woff2")
  elseif(ext STREQUAL ".ico")
    set(mime "image/x-icon")
  else()
    set(mime "text/plain")
  endif()
  set(${out_var} "${mime}" PARENT_SCOPE)
endfunction()

set(body "")
set(table "")
set(index 0)

# The caller joins paths with "|" so the list survives being passed through -D.
string(REPLACE "|" ";" CAD_FILES "${CAD_FILES}")

foreach(rel IN LISTS CAD_FILES)
  set(abs "${CAD_ROOT}/${rel}")
  if(NOT EXISTS "${abs}")
    message(FATAL_ERROR "embed_resources.cmake: missing resource ${abs}")
  endif()

  file(READ "${abs}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR bytelen "${hexlen} / 2")

  # One pass over the hex string; anything per-byte in CMake gets slow fast.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  # Wrap so the generated file stays something a human can open.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")

  cad_mime_for_path("${rel}" mime)

  string(APPEND body
      "// ${rel} (${bytelen} bytes)\n"
      "const unsigned char kData${index}[] = {\n    ${bytes}\n};\n\n")
  string(APPEND table
      "    {\"${rel}\", \"${mime}\", kData${index}, ${bytelen}u},\n")

  math(EXPR index "${index} + 1")
endforeach()

set(header "// Generated by cmake/embed_resources.cmake. Do not edit.
#pragma once

#include <cstddef>

namespace cad::resources {

struct Entry {
  const char* path;         // e.g. \"newtab.html\"
  const char* mime_type;    // e.g. \"text/html\"
  const unsigned char* data;
  size_t size;
};

// Null-safe lookup by exact path. Returns nullptr when absent.
const Entry* Find(const char* path);

const Entry* All();
size_t Count();

}  // namespace cad::resources
")

set(source "// Generated by cmake/embed_resources.cmake. Do not edit.
#include \"resources/generated_resources.h\"

#include <cstring>

namespace cad::resources {
namespace {

${body}const Entry kEntries[] = {
${table}};

}  // namespace

const Entry* All() {
  return kEntries;
}

size_t Count() {
  return sizeof(kEntries) / sizeof(kEntries[0]);
}

const Entry* Find(const char* path) {
  if (!path) {
    return nullptr;
  }
  for (size_t i = 0; i < Count(); ++i) {
    if (std::strcmp(kEntries[i].path, path) == 0) {
      return &kEntries[i];
    }
  }
  return nullptr;
}

}  // namespace cad::resources
")

# Only rewrite when the content actually changes, so a rebuild of the browser
# is not forced on every configure.
if(EXISTS "${CAD_OUT_H}")
  file(READ "${CAD_OUT_H}" existing_h)
else()
  set(existing_h "")
endif()
if(NOT existing_h STREQUAL "${header}")
  file(WRITE "${CAD_OUT_H}" "${header}")
endif()

if(EXISTS "${CAD_OUT_CC}")
  file(READ "${CAD_OUT_CC}" existing_cc)
else()
  set(existing_cc "")
endif()
if(NOT existing_cc STREQUAL "${source}")
  file(WRITE "${CAD_OUT_CC}" "${source}")
endif()
